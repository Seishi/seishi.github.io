  "lesson": {
    "language": "zh-CN",
    "meta": "交互解题 · 内切球半径",
    "title": "长方体 $ABCD$-$EFGH$ 中，$AB=BC$，点 $P$ 是正方形 $EFGH$ 的中心。若 $|AE|+\\dfrac{\\sqrt{3}}{2}|AD|=1$，则四棱锥 $P$-$ABCD$ 内切球半径的最大值是",
    "answerLabel": "内切球半径的最大值",
    "answerValue": "$\\dfrac{1}{6}$"
  },
  "steps": [
    {
      "title": "底面为正方形的四棱锥",
      "content": "<p>$AB=BC$ 的长方体底面是正方形，记边长 $a=AD=AB$，高 $AE=h$。$P$ 是上底中心，故 $P$-$ABCD$ 是正四棱锥，高为 $h$，顶点在底面中心正上方。</p><p>条件 $h+\\dfrac{\\sqrt{3}}{2}a=1$，即 $h=1-\\dfrac{\\sqrt{3}}{2}a$，且 $a\\in\\left(0,\\dfrac{2}{\\sqrt{3}}\\right)$。</p>",
      "highlight": [
        "Axis",
        "Plane_ABCD",
        "Point_P",
        "Len_AB",
        "Len_AE"
      ],
      "cameraPos": {
        "x": 4.73,
        "y": 4.04,
        "z": 4.73
      }
    },
    {
      "title": "内切球半径公式",
      "content": "<p>$r=\\dfrac{3V}{S_{\\text{全}}}$。$V=\\dfrac{1}{3}a^{2}h$，侧面是四个全等等腰三角形，斜高 $\\sqrt{h^{2}+\\dfrac{a^{2}}{4}}$，故</p>$$r=\\dfrac{ah}{a+2\\sqrt{h^{2}+\\dfrac{a^{2}}{4}}}.$$",
      "highlight": [
        "Point_I",
        "Sphere_in",
        "Point_P",
        "Plane_ABCD"
      ],
      "cameraPos": {
        "x": 4.49,
        "y": 5.07,
        "z": 3.83
      }
    },
    {
      "title": "代入约束并对 $a$ 求最大",
      "content": "<p>令 $s=\\dfrac{\\sqrt{3}}{2}a$，则 $s\\in(0,1)$，$h=1-s$，</p>$$r(s)=\\dfrac{s(1-s)}{s+\\sqrt{4s^{2}-6s+3}}.$$<p>$r'(s)=0$ 的根为 $s=\\dfrac{1}{2}$，即 $a=\\dfrac{1}{\\sqrt{3}}$、$h=\\dfrac{1}{2}$，$r=\\dfrac{1}{6}$。端点 $s\\to 0^{+}$ 或 $s\\to 1^{-}$ 时 $r\\to 0$。内切球半径的最大值为 $\\dfrac{1}{6}$。</p>",
      "highlight": [
        "Point_P",
        "Point_I",
        "Sphere_in",
        "Len_AB",
        "Len_AE"
      ],
      "cameraPos": {
        "x": 5.16,
        "y": 3.74,
        "z": 4.49
      }
    }
  ],
