      "lBD": {"type": "line", "a": 4, "b": 3, "c": 2},
      "lAD": {"type": "line", "a": 4, "b": -1, "c": -2},
      "lBC": {"type": "line", "a": 2, "b": -1, "c": -4},
      "xaxis": {"type": "line", "a": 0, "b": 1, "c": 0},
      "Circ": {"type": "circle", "center": "W", "radius": "10/3"}
    },
    "points": {
      "G": [-3, 0]
    },
    "givens": [
      {"name": "F", "kind": "focus", "of": "Gamma", "which": "right"},
      {"name": "A", "kind": "on_curve", "curve": "Gamma", "t": 2},
      {"name": "B", "kind": "on_curve", "curve": "Gamma", "t": -2},
      {"name": "C", "kind": "on_curve", "curve": "Gamma", "t": 4},
      {"name": "D", "kind": "on_curve", "curve": "Gamma", "t": -1},
      {"name": "M", "kind": "intersection", "of": ["lAC", "lBD"]},
      {"name": "N", "kind": "intersection", "of": ["lAD", "lBC"]},
      {"name": "W", "kind": "midpoint", "of": ["M", "N"]}
    ],
    "query": {"type": "custom", "expr": "-3"}
