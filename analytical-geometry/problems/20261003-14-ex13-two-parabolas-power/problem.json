    "frame": {"xmin": -3, "xmax": 4, "ymin": -3, "ymax": 4},
    "curves": {
      "C1": {"type": "parabola", "p": 1, "vertex": [0, "-1/2"], "axis": "y", "direction": "+"},
      "C2": {"type": "parabola", "p": 1, "vertex": ["-1/2", 0], "axis": "x", "direction": "+"},
      "l": {"type": "line", "a": 1, "b": 1, "c": 1},
