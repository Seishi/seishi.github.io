    },
    "points": {},
    "givens": [
      {"name": "O", "kind": "focus", "of": "C1", "which": "upper"},
      {"name": "A", "kind": "intersection", "of": ["C1", "AB"], "which": "upper"},
      {"name": "B", "kind": "intersection", "of": ["C1", "AB"], "which": "lower"},
      {"name": "C", "kind": "intersection", "of": ["AB", "l"]}
    ],
    "query": {"type": "custom", "expr": "0"}
